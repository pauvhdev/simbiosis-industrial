# =============================================================================
#  Simbiosis Industrial Anónima — configuración
# =============================================================================
#  TODO ES OPCIONAL. Sin ninguna variable, el proyecto arranca con:
#    - PGlite  (Postgres embebido en ./.data/pglite)
#    - motor de IA local (reglas + embeddings hasheados)
#  Coste: 0 €. Cuentas necesarias: ninguna.
# =============================================================================


# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# Déjala vacía para usar PGlite en local.
# Rellénala para apuntar a un Postgres con pgvector. Ambos usan el MISMO
# supabase/schema.sql, así que basta con volver a lanzar `npm run db:migrate`.
#
#   Supabase (free tier): Project Settings > Database > Connection string > URI
#     postgresql://postgres.<ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
#
#   Neon (free tier):
#     postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
#
# DATABASE_URL=


# -----------------------------------------------------------------------------
# PROVEEDOR DE IA
# -----------------------------------------------------------------------------
# openai | google | local
# Si no se indica, se autodetecta según la API key presente; sin ninguna, 'local'.
AI_PROVIDER=local

# --- Opción de pago: la del enunciado original -------------------------------
# gpt-4o-mini + text-embedding-3-small (1536 dims nativas).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Opción gratuita con cuota: Google AI Studio ------------------------------
# API key gratis en https://aistudio.google.com/apikey (sin tarjeta).
# gemini-2.5-flash + gemini-embedding-001 truncado a 1536 dims vía MRL.
# GOOGLE_GENERATIVE_AI_API_KEY=...
# GOOGLE_MODEL=gemini-2.5-flash


# -----------------------------------------------------------------------------
# AVANZADO
# -----------------------------------------------------------------------------
# Ruta del directorio de datos de PGlite.
# PGLITE_DATA_DIR=./.data/pglite
